# ============================================
# 🌐 Application Environment
# ============================================
APP_IDENTITY=provider
NODE_ENV=development
CONFIG_FILE=config/config.json

# ============================================
# 🚀 Provider Service
# ============================================
PROVIDER_CONTAINER_NAME=provider
PROVIDER_IMAGE=barfinex/provider:latest
PROVIDER_COMMAND="yarn start:provider:dev"
PROVIDER_API_PORT=8081
PROVIDER_API_TOKEN="ExampleToken#123!ABC"
# Detector (and other apps): URL for app registration. Token must match provider config.apiToken.
PROVIDER_API_URL=https://localhost:8081/api
# For detector: set PROVIDER_API_TOKEN to same value as provider apiToken so register/heartbeat succeed.
# If Provider uses a self-signed cert (e.g. https://localhost:8081), allow it in dev only:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================
# 🔐 SSL Certificates (Local or Production)
# ============================================
SSL_CERT=./cert/localhost.pem
SSL_KEY=./cert/localhost-key.pem

# ============================================
# 🗄️ MongoDB
# ============================================
MONGO_CONTAINER_NAME=mongo
MONGO_IMAGE=mongo:6.0
MONGO_PORT=27017
MONGO_HOST=mongo
# MONGO_HOST=localhost  # (использовать при локальной разработке)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=barfinex_demo

# ============================================
# ⚡ QuestDB (Time-Series Storage)
# ============================================

# Docker
QUESTDB_CONTAINER_NAME=questdb
QUESTDB_IMAGE=questdb/questdb:9.2.2
QUESTDB_DATA_DIR=C:/barfinex-data/questdb
QUESTDB_JAVA_OPTS=-Xms4g -Xmx12g
QUESTDB_MEM_LIMIT=28g
QUESTDB_CPUS=12
CANDLE_VERBOSE_LOGS=false
CANDLES_BACKFILL_OVERLAP_CANDLES=2
CANDLES_LOOKBACK_DAY_DAYS=540
CANDLES_LOOKBACK_H4_DAYS=120
CANDLES_LOOKBACK_H2_DAYS=120
CANDLES_LOOKBACK_H1_DAYS=120
CANDLES_LOOKBACK_MIN30_DAYS=90
CANDLES_LOOKBACK_MIN15_DAYS=90
CANDLES_LOOKBACK_MIN5_DAYS=90
CANDLES_LOOKBACK_MIN1_DAYS=30

# Порты QuestDB
# 8812 — PostgreSQL Wire Protocol (SELECT)
# 9000 — Admin REST API
# 9009 — Influx Line Protocol (мгновенная запись)
QUESTDB_PG_PORT=8812
QUESTDB_HTTP_PORT=9000
QUESTDB_ILP_PORT=9009

# Хост (локально или в Docker сетке)
QUESTDB_HOST=localhost

# Аутентификация (по умолчанию отключена в OSS версии)
# Можно оставить пустыми или добавить свою
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest

# База для SQL клиента (фактически не используется, но нужна для совместимости)
QUESTDB_DATABASE=main

# Логировать каждый SQL-запрос к QuestDB с номером операции (#N) — чтобы выявить запрос, после которого таблица уходит в suspended (включено по умолчанию)
QUESTDB_LOG_SQL=false
QUESTDB_AUDIT_ENABLED=false

EVENTSINK_ENABLED=true
EVENTSINK_FLUSH_INTERVAL=50
EVENTSINK_BATCH_SIZE=500


# ============================================
# ⚡ Redis
# ============================================
REDIS_CONTAINER_NAME=redis
REDIS_IMAGE=redis:7.2.4
REDIS_PORT=6379
REDIS_HOST=redis
# REDIS_HOST=localhost  # (использовать при локальной разработке)

# ============================================
# 🧠 Binance API (Production Keys)
# ============================================
BINANCE_API_KEY=prod-binance-key-123456
BINANCE_API_SECRET=prod-binance-secret-654321

# ============================================
# 🧪 Binance API (Testnet Keys)
# ============================================
TESTNET_BINANCE_SPOT_KEY=testnet-key-123456
TESTNET_BINANCE_SPOT_SECRET=testnet-secret-654321

# ============================================
# 💰 Alpaca API
# ============================================
ALPACA_API_KEY=alpaca-demo-key
ALPACA_API_SECRET=alpaca-demo-secret

# ============================================
# 💰 Tinkoff Invest API
# ============================================
TINKOFF_API_TOKEN=tinkoff-demo-token
TINKOFF_ACCOUNT_ID=tinkoff-demo-account

# ============================================
# 🤖 Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=1234567890:AAExampleBotTokenDemo123
TELEGRAM_CHAT_ID=@barfinex_dev_channel
DETECTOR_TELEGRAM_ENABLED=false
DETECTOR_TELEGRAM_CHAT_ID=@barfinex_dev_channel
DETECTOR_TELEGRAM_MIN_INTERVAL_MS=15000
DETECTOR_TELEGRAM_DEDUP_WINDOW_MS=120000

# ============================================
# 🛡 Detector Safety
# ============================================
DETECTOR_READONLY=true

# ============================================
# 🤖 Advisor / Inspector integration
# ============================================
INSPECTOR_API_URL=http://localhost:8008/api
ADVISOR_API_URL=http://localhost:8010/api
ADVISOR_ORCHESTRATOR_ENABLED=true
ADVISOR_LEGACY_LOOP_ENABLED=false

# ============================================
# 🌍 CORS and Origins
# ============================================
CORS_ORIGINS=https://studio.barfinex.com

# ============================================
# 🧰 Portainer (optional)
# ============================================
PONTEINER_CONTAINER_NAME=portainer
PONTEINER_IMAGE=portainer/portainer-ce:latest
PONTEINER_PORT=9443
PONTEINER_HOST=portainer
# PONTEINER_HOST=localhost
PONTEINER_ADMIN_USERNAME=admin
PONTEINER_ADMIN_PASSWORD=Admin123!

# ============================================
# 🧭 Redis Commander (optional)
# ============================================
REDIS_COMMANDER_CONTAINER_NAME=redis_commander
REDIS_COMMANDER_IMAGE=rediscommander/redis-commander:latest
REDIS_COMMANDER_PORT=8102
REDIS_COMMANDER_HOSTNAME=redis-commander
REDIS_COMMANDER_REDIS_HOST=redis

# ============================================
# 💻 Mongo Express (optional)
# ============================================
MONGO_EXPRESS_CONTAINER_NAME=mongo-express
MONGO_EXPRESS_IMAGE=mongo-express
MONGO_EXPRESS_PORT=8103

# ============================================
# 💻 PostgreSQL
# ============================================
# DB_PORT=25060
# DB_USERNAME=barfinexStudio
# DB_NAME=admin
# DB_PASSWORD=Admin123!