# ============================================
# Application runtime + infra only
# Functional tuning moved to config/*.json
# ============================================
# Local dev: Provider needs Redis (6379) and QuestDB (PG 8812, ILP 9009).
# From monorepo root: docker compose -f docker-compose-infra.yml up -d redis questdb
# (or docker compose -f docker-compose-redis.yml up -d for Redis only).
# ============================================
APP_IDENTITY=provider
NODE_ENV=development
CONFIG_FILE=config/config.json

# ============================================
# Logging defaults (production-safe)
# ============================================
LOG_LEVEL=log
# log | debug | warn | error
EVENTBUS_DEBUG=false
# enables internal EventBus debug logging
BINANCE_WS_DEBUG=false
# enables detailed Binance WS subscription logs
SOCKET_BRIDGE_DEBUG=false
# enables WebSocket bridge message logging
QUESTDB_DEBUG=false
# enables QuestDB write/query debug logs

# ============================================
# Provider service
# ============================================
PROVIDER_CONTAINER_NAME=provider
PROVIDER_IMAGE=barfinex/provider:latest
PROVIDER_COMMAND="yarn start:provider:dev"
PROVIDER_API_PORT=8081
PROVIDER_API_TOKEN="ExampleToken#123!ABC"
PROVIDER_API_URL=https://localhost:8081/api
ADVISOR_PROVIDER_TLS_INSECURE=true

# Local app API ports
DETECTOR_API_PORT=8101
INSPECTOR_API_PORT=8008
ADVISOR_API_PORT=8009

# ============================================
# TLS
# ============================================
SSL_CERT=./cert/localhost.pem
SSL_KEY=./cert/localhost-key.pem

# ============================================
# MongoDB
# ============================================
MONGO_CONTAINER_NAME=mongo
MONGO_IMAGE=mongo:6.0
MONGO_PORT=27017
MONGO_HOST=mongo
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=barfinex_demo

# ============================================
# QuestDB (PG=8812, ILP=9009; РґР»СЏ Р»РѕРєР°Р»СЊРЅРѕРіРѕ Р·Р°РїСѓСЃРєР° host=localhost)
# ============================================
QUESTDB_CONTAINER_NAME=questdb
QUESTDB_IMAGE=questdb/questdb:9.2.2
QUESTDB_DATA_DIR=C:/barfinex-data/questdb
QUESTDB_JAVA_OPTS=-Xms4g -Xmx12g
QUESTDB_MEM_LIMIT=28g
QUESTDB_CPUS=12
# Candle warmup/backfill tuning moved to config/config.provider.json:
# provider.runtime.candleVerboseLogs, provider.candleSync.overlapCandles,
# provider.candleSync.lookbackDays
QUESTDB_PG_PORT=8812
QUESTDB_HTTP_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_HOST=localhost
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DATABASE=main
QUESTDB_BUFFER_LIMIT_ROWS=10000
QUESTDB_BUFFER_MAX_ROWS=10000
QUESTDB_BUFFER_HARD_LIMIT=50000

# Provider QuestDB write pipeline (buffered ILP; Redis is primary, QuestDB secondary)
PROVIDER_QUESTDB_WRITE_BATCH_SIZE=500
PROVIDER_QUESTDB_WRITE_FLUSH_MS=50
PROVIDER_QUESTDB_WRITE_QUEUE_SIZE=10000
PROVIDER_QUESTDB_RECONNECT_BASE_MS=500
PROVIDER_QUESTDB_RECONNECT_MAX_MS=10000
# Optional: circuit breaker вЂ“ consecutive failures before pause, cooldown (ms)
# PROVIDER_QUESTDB_CIRCUIT_FAILURE_THRESHOLD=5
# PROVIDER_QUESTDB_CIRCUIT_COOLDOWN_MS=30000
# Adaptive batching: flush interval jitter (ms) to avoid synchronized timer spikes (e.g. 5 = 50ms В± 5ms)
# PROVIDER_QUESTDB_FLUSH_JITTER_MS=5
# Coalescing: merge ILP rows with same table+timestamp+symbol within window (ms). 0 = disabled. Default 5.
# PROVIDER_QUESTDB_COALESCE_WINDOW_MS=5
# Backpressure: warn when queue exceeds this % of capacity; drop oldest when queue exceeds drop %
# PROVIDER_QUESTDB_BACKPRESSURE_WARN_PCT=80
# PROVIDER_QUESTDB_BACKPRESSURE_DROP_PCT=95

# QuestDB startup resilience (sync this block to .env, .env.local, .env.production)
# Wait for QuestDB to accept connections before DDL (avoids ECONNRESET on cold start). 0 = skip wait.
# QUESTDB_READY_MAX_ATTEMPTS=30
# QUESTDB_READY_INTERVAL_MS=1000
# Delay (ms) after ready before running DDL (lets QuestDB settle). Default 5000.
# QUESTDB_DDL_INITIAL_DELAY_MS=5000
# DDL phase: retries on transient connection errors (ECONNRESET etc.), base delay (ms), deferred on final failure, deferred interval (ms)
# QUESTDB_DDL_PHASE_MAX_ATTEMPTS=10
# QUESTDB_DDL_PHASE_BASE_MS=3000
# QUESTDB_DDL_DEFERRED_ON_FAIL=true
# QUESTDB_DDL_DEFERRED_INTERVAL_MS=30000
# PG query retries on ECONNRESET: max attempts, base and max delay (ms). Defaults: 10, 200, 3000.
# QUESTDB_QUERY_MAX_ATTEMPTS=10
# QUESTDB_QUERY_RETRY_BASE_MS=200
# QUESTDB_QUERY_RETRY_MAX_DELAY_MS=3000
EVENTSINK_ENABLED=true
EVENTSINK_FLUSH_INTERVAL=50
EVENTSINK_BATCH_SIZE=500

# ============================================
# Redis
# ============================================
REDIS_CONTAINER_NAME=redis
REDIS_IMAGE=redis:7.2.4
REDIS_PORT=6379
# Р›РѕРєР°Р»СЊРЅС‹Р№ Р·Р°РїСѓСЃРє: localhost. Р’ Docker Compose: redis
REDIS_HOST=localhost
# Provider WS bridge: connect timeout (ms), keep-alive (ms); reconnects use REDIS_RECONNECT_* in lib
# REDIS_CONNECT_TIMEOUT_MS=10000
# REDIS_KEEP_ALIVE_MS=5000
REDIS_RECONNECT_BASE_DELAY_MS=1000
REDIS_RECONNECT_MAX_DELAY_MS=15000
REDIS_EMIT_QUEUE_LIMIT=5000
# Backward-compatible aliases (legacy)
REDIS_RECONNECT_BASE_MS=1000
REDIS_RECONNECT_MAX_MS=15000
REDIS_EMIT_QUEUE_MAX_SIZE=5000
REDIS_EMIT_QUEUE_WARN_THROTTLE_MS=5000
WEBSOCKET_SERVER_PORT=8082
BINANCE_WS_MAX_RETRIES=0
BINANCE_WS_RECONNECT_BASE_DELAY_MS=5000
BINANCE_WS_RECONNECT_MAX_DELAY_MS=30000
BINANCE_WS_RECONNECT_JITTER_MS=1500
BINANCE_WS_STALL_THRESHOLD_MS=5000
BINANCE_WS_STALL_COOLDOWN_MS=10000
BINANCE_WS_STALL_THRESHOLD_TRADES_MS=5000
BINANCE_WS_STALL_THRESHOLD_ORDERBOOK_MS=5000
BINANCE_WS_STALL_THRESHOLD_CANDLES_MS=20000
BINANCE_WS_STALL_THRESHOLD_SYMBOLPRICES_MS=20000
BINANCE_WS_STALL_CHECK_INTERVAL_MS=1000
BINANCE_WS_WATCHDOG_RECONNECT_BASE_DELAY_MS=0
BINANCE_WS_WATCHDOG_RECONNECT_JITTER_MS=1500

# ============================================
# External API credentials
# ============================================
BINANCE_API_KEY=prod-binance-key-123456
BINANCE_API_SECRET=prod-binance-secret-654321
TESTNET_BINANCE_SPOT_KEY=testnet-key-123456
TESTNET_BINANCE_SPOT_SECRET=testnet-secret-654321
ALPACA_API_KEY=alpaca-demo-key
ALPACA_API_SECRET=alpaca-demo-secret
TINKOFF_API_TOKEN=tinkoff-demo-token
TINKOFF_ACCOUNT_ID=tinkoff-demo-account
OPENAI_API_KEY=

# ============================================
# Inspector в†’ Provider auth (config-driven)
# Inspector calls Provider REST API for execution; token must match Provider apiToken.
# ============================================
INSPECTOR_PROVIDER_API_TOKEN=
# Fallback if unset: PROVIDER_BEARER_TOKEN, then PROVIDER_API_TOKEN
INSPECTOR_PROVIDER_AUTH_MODE=both
# One of: bearer | x-api-token | both. bearer=Authorization: Bearer <token>; x-api-token=header x-api-token.
INSPECTOR_PROVIDER_AUTH_HEADER=
# Optional: custom header name for token (e.g. X-Custom-Auth). Token value still from INSPECTOR_PROVIDER_API_TOKEN.

# ============================================
# Messaging and service endpoints
# ============================================
TELEGRAM_BOT_TOKEN=1234567890:AAExampleBotTokenDemo123
TELEGRAM_CHAT_ID=@barfinex_dev_channel
INSPECTOR_API_URL=http://localhost:8008/api
ADVISOR_API_URL=http://localhost:8009/api
DETECTOR_API_URL=http://localhost:8101/api
CORS_ORIGINS=https://studio.barfinex.com
PROVIDER_BOOTSTRAP_RETRY_BASE_MS=2000
PROVIDER_BOOTSTRAP_RETRY_MAX_MS=30000
# MCP supervisor: set PROVIDER_MCP_INSECURE_TLS=true when Provider uses self-signed HTTPS
PROVIDER_MCP_INSECURE_TLS=true
PROVIDER_MCP_SUPERVISOR_METRICS_LOG_INTERVAL_MS=30000
PROVIDER_MCP_SUPERVISOR_STATUS_FILE=.runtime/provider-mcp-supervisor.json
PROVIDER_MCP_SUPERVISOR_STALE_MS=15000
PROVIDER_ALERT_MARKETDATA_LAG_MS_WARN=10000
PROVIDER_ALERT_REDIS_EMIT_QUEUE_SIZE_WARN=1000
PROVIDER_ALERT_QUESTDB_BUFFER_SIZE_WARN=10000
PROVIDER_ALERT_REDIS_DROPPED_EVENTS_WARN=1
PROVIDER_ALERT_QUESTDB_DROPPED_ROWS_WARN=1
PROVIDER_ALERT_WS_RECONNECT_ATTEMPTS_WARN=25

# ============================================
# Optional infra tools
# ============================================
PONTEINER_CONTAINER_NAME=portainer
PONTEINER_IMAGE=portainer/portainer-ce:latest
PONTEINER_PORT=9443
PONTEINER_HOST=portainer
PONTEINER_ADMIN_USERNAME=admin
PONTEINER_ADMIN_PASSWORD=Admin123!

REDIS_COMMANDER_CONTAINER_NAME=redis_commander
REDIS_COMMANDER_IMAGE=rediscommander/redis-commander:latest
REDIS_COMMANDER_PORT=8102
REDIS_COMMANDER_HOSTNAME=redis-commander
# Р›РѕРєР°Р»СЊРЅРѕ: localhost. Р’ Docker: redis
REDIS_COMMANDER_REDIS_HOST=localhost

MONGO_EXPRESS_CONTAINER_NAME=mongo-express
MONGO_EXPRESS_IMAGE=mongo-express
MONGO_EXPRESS_PORT=8103

